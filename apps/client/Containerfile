# Stage 1: Build
FROM docker.io/node:22-slim AS build

# Corepack is needed for Yarn 4
RUN corepack enable

WORKDIR /app

# Copy root configuration
COPY package.json yarn.lock .yarnrc.yml ./

# Copy the client application
COPY apps/client ./apps/client

# Install dependencies and build
RUN yarn install
RUN yarn workspace client generate

# Stage 2: Serve
FROM docker.io/nginx:alpine

# Copy the static output from the build stage
COPY --from=build /app/apps/client/.output/public /usr/share/nginx/html

# Add a basic nginx config to handle SPA routing if needed
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
